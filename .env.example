# Required. Generate a strong value before starting the service:
#   openssl rand -hex 32
POTATO_GATEWAY_TOKEN=

# Defaults keep the service local-only.
POTATO_GATEWAY_HOST=127.0.0.1
POTATO_GATEWAY_PORT=8765
POTATO_GATEWAY_LOG_LEVEL=INFO
POTATO_HUB_URL=http://127.0.0.1:8787
# Optional. When omitted, Gateway reads ../potato-relay/.hub-token inside POTATO_HERMES_HOME.
# POTATO_HUB_TOKEN=replace-with-the-potato-hub-token

# Read-only Hermes profile integration. Keep all paths under POTATO_HERMES_HOME.
POTATO_HERMES_HOME=/Users/zhanghong/.hermes
POTATO_AGENT_REGISTRY_PATH=/Users/zhanghong/.hermes/potato-gateway/config/agents.yaml
POTATO_CALIBRATION_STATE_DIR=/Users/zhanghong/.hermes/potato-gateway/runtime/calibration
POTATO_GATEWAY_DB_PATH=/Users/zhanghong/.hermes/potato-gateway/runtime/potato-gateway.db
